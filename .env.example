# Copy to .env and fill in. Never commit .env — see .gitignore.

# ── Core ────────────────────────────────────────────────────────────────────
# Public origin the browser reaches. Must be https in production: WebAuthn
# (passkeys) refuses to work over plain http except on localhost.
PUBLIC_ORIGIN=http://localhost:8080

# WebAuthn Relying Party. RP_ID must be the registrable domain of PUBLIC_ORIGIN
# (no scheme, no port). "localhost" is valid for development.
RP_ID=localhost
RP_NAME=Homesh

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=homesh
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=homesh
DATABASE_URL=postgresql+psycopg://homesh:change-me-before-first-run@db:5432/homesh

# ── Cryptography ────────────────────────────────────────────────────────────
# Master key wrapping per-record data keys (Google OAuth tokens etc). Held only
# in the environment, never in the database — a DB dump alone must be useless.
# Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=

# Signs short-lived media URLs and session cookies. Generate the same way.
SECRET_KEY=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Minutes a signed media URL stays valid. Short by design; players renew.
MEDIA_URL_TTL_MINUTES=5

# Where thumbnails and derived files are written. The compose stack mounts a
# volume here; running outside a container, point it somewhere writable.
CACHE_DIR=/var/lib/homesh/cache

# ── Devices ─────────────────────────────────────────────────────────────────
# Denon/Marantz receiver address. Needed only while the core runs in a container:
# Docker's bridge network cannot do the multicast discovery would require.
# Leave blank once the home agent handles discovery.
DENON_HOST=

# Address a device on your LAN can reach this server at, e.g. http://192.0.2.10:8080.
# The receiver fetches audio itself, so localhost will not do. Required for zone
# playback; everything else works without it.
LAN_BASE_URL=

# ── Google Drive ────────────────────────────────────────────────────────────
# Path *inside the container* to the service-account JSON key. Put the file at
# ./.secrets/gdrive.json on the host; compose mounts .secrets read-only.
# Share the Drive folders you want indexed with the key's client_email.
GDRIVE_KEY_FILE=/run/secrets/gdrive.json

LOG_LEVEL=INFO

# ── Local media ─────────────────────────────────────────────────────────────
# Host folder to index, mounted read-only into the container at /media/library.
# On Windows use a forward-slash path, e.g. D:/Media or //SERVER/share.
MEDIA_HOST_PATH=./sample-media

# Roots to index inside the container, as "Name=/path" separated by ';'.
# Each becomes a mount point in the unified namespace: Library -> /local/library
MEDIA_ROOTS=Library=/media/library
