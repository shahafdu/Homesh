#!/bin/sh
#
# Refuse to push a private address or a device id — in any commit being sent.
#
# The pre-commit hook guards what is written today. This guards what leaves the
# machine, which is a different question: a commit made before the hook existed,
# an amend, a rebase that resurrects an old line, or a branch pushed from
# somewhere else all reach the remote without passing through pre-commit.
#
# The repository is public. Everything here is recoverable except a push.

remote_head=$(git rev-parse --verify --quiet "refs/remotes/$1/main" 2>/dev/null)
if [ -n "$remote_head" ]; then
  range="$remote_head..HEAD"
else
  range="HEAD"
fi

# Names that are this household's own business: the other apps it runs, say.
# They are listed in .local/private-words.txt, one per line, which is not
# tracked -- a list of them committed here would publish exactly what it
# guards. No file, nothing checked: a fresh clone has nothing to hide yet.
words=.local/private-words.txt

bad=""
for commit in $(git rev-list "$range" 2>/dev/null); do
  hits=$(git grep -nIE '(^|[^0-9.])(10|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9]{1,3}\.[0-9]{1,3}' \
         "$commit" -- . 2>/dev/null | head -3)
  ids=$(git grep -nIE 'uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}' "$commit" -- . 2>/dev/null | head -3)
  keys=$(git grep -nIE 'ssh-(ed25519|rsa|ecdsa-[a-z0-9-]+|dss) AAAA[0-9A-Za-z+/]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|[a-z0-9-]+\.tail[0-9a-f]{4,}\.ts\.net|sk-or-v1-[0-9a-f]{16,}|sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}' \
         "$commit" -- . 2>/dev/null | head -3 | cut -c1-80)
  named=""
  if [ -s "$words" ]; then
    # The message is published as much as the files are.
    named=$( { git grep -nIiF -f "$words" "$commit" -- . 2>/dev/null;
               git log -1 --format=%B "$commit" | grep -niF -f "$words" | sed 's/^/message:/'; }              | head -3 | cut -c1-80)
  fi
  if [ -n "$hits" ] || [ -n "$ids" ] || [ -n "$keys" ] || [ -n "$named" ]; then
    bad="$bad
$(git log -1 --format='%h %s' "$commit")
$hits$ids$keys$named"
  fi
done

if [ -n "$bad" ]; then
  echo
  echo "REFUSING TO PUSH: a commit being sent contains a private address, a device id, an SSH key, a tailnet name, an API key or a name from $words."
  echo "$bad" | head -20
  echo
  echo "This repository is public. Fix the commit — not just the working tree —"
  echo "with an amend or a rebase, then push again."
  exit 1
fi
