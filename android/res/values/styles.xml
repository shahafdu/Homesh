<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black, chromeless, and dark from the first frame: a TV app that flashes
         a white system background while loading looks broken in a dark room. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
