<?xml version="1.0" encoding="utf-8"?>
<!--
    Homesh Connect — the phone's way in.

    Deliberately not the interface. The interface is the web app, which the
    browser already runs well and where the passkey lives. This exists for the
    one thing a web page cannot do: when the server cannot be reached because
    Android has stopped Tailscale, open Tailscale.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.homesh.phone"
    android:versionCode="3"
    android:versionName="1.0.2">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11 hides other apps unless they are named here. Without this
         Tailscale is invisible: the launch intent comes back null and the app
         reports it is not installed when it plainly is. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Homesh"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.homesh.tv.PhoneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Typing an address, shared with the television app. -->
        <activity
            android:name="com.homesh.tv.SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
