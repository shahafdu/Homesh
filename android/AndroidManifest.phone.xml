<?xml version="1.0" encoding="utf-8"?>
<!--
    Homesh Connect — the phone's way in.

    It shows Homesh in a Custom Tab: the real browser engine, rendered inside
    this app. Not a WebView, which has no WebAuthn and its own cookie jar, so
    the passkey and the signed-in session would both be missing exactly where
    somebody had committed to using it.

    What the app adds over a bookmark is the part a web page cannot do. When
    the server is unreachable because Android has stopped Tailscale to save
    battery, it says so and opens Tailscale — and the page that could not load
    is in no position to do either.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.homesh.phone"
    android:versionCode="8"
    android:versionName="1.3.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Check for updates" installs what it finds. Android still shows its own
         installer prompt; what this removes is finding /phone in a browser. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11 hides other apps unless they are named here. Without this
         Tailscale is invisible: the launch intent comes back null and the app
         reports it is not installed when it plainly is. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Which browsers can host a Custom Tab. Without this the service
             lookup returns null for every one of them and Homesh opens as a
             separate browser task instead of inside this app. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Homesh"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.homesh.tv.PhoneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Passes a downloaded update to the system installer as content, the
             only form Android accepts. The same class as the television's; its
             authority is this app's own package name plus ".updates". -->
        <provider
            android:name="com.homesh.tv.UpdateProvider"
            android:authorities="com.homesh.phone.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Typing an address, shared with the television app. -->
        <activity
            android:name="com.homesh.tv.SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
