# Normalise line endings. Development happens on Windows, CI runs on Linux, and
# the images are Linux — CRLF leaking into a shell script or a Dockerfile breaks
# it there with a confusing error.
* text=auto eol=lf

# Windows-native tooling stays CRLF so it opens cleanly in Windows editors.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
